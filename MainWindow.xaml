<Window x:Class="AudioMicPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioMicPad"
        Icon="audiomicpad.ico"
        Height="820"
        Width="1240"
        MinHeight="680"
        MinWidth="1020"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="2,0,2,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Image Width="52"
             Height="52"
             Source="audiomicpad.png"
             Stretch="Uniform"
             Margin="0,0,13,0"
             AutomationProperties.Name="AudioMicPad logo"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="AudioMicPad" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="Mix your voice, music, and soundboard into one virtual microphone."
                   Style="{StaticResource SecondaryTextStyle}"
                   Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Theme" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox x:Name="ThemeBox" Width="120" AutomationProperties.Name="Theme" SelectionChanged="ThemeBox_SelectionChanged"/>
        <Button Margin="10,0,0,0"
                Padding="11,6"
                AutomationProperties.Name="Information and help"
                ToolTip="How to use AudioMicPad"
                Click="Info_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,7,0"/>
            <TextBlock Text="Help"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Music folder" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,12,0"/>
        <TextBox x:Name="FolderBox" Grid.Column="1" Height="36" VerticalContentAlignment="Center" AutomationProperties.Name="Music folder"/>
        <Button Grid.Column="2" Content="Choose folder" Margin="10,0,6,0" Click="ChooseFolder_Click"/>
        <Button Grid.Column="3" Content="Refresh" Click="Refresh_Click"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="370"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource CardStyle}" Margin="0,0,14,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Sounds and playlist" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
              <TextBlock x:Name="SoundCountText" Text="No sounds loaded" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Double-click to play as an effect" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/>
          </Grid>

          <ListView x:Name="SoundsList"
                    Grid.Row="1"
                    AutomationProperties.Name="Sounds and playlist"
                    MouseDoubleClick="SoundsList_DoubleClick"
                    SelectionChanged="SoundsList_SelectionChanged">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="#" Width="44" DisplayMemberBinding="{Binding IndexDisplay}"/>
                <GridViewColumn Header="File" Width="420" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="Shortcut" Width="140" DisplayMemberBinding="{Binding Key}"/>
                <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding Status}"/>
              </GridView>
            </ListView.View>
          </ListView>

          <Border Grid.Row="2"
                  Background="{DynamicResource ElevatedSurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12"
                  Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Selected sound shortcut" FontWeight="SemiBold"/>
                <TextBlock x:Name="ShortcutHelpText"
                           Text="Select a sound to assign a global shortcut."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,3,8,0"/>
              </StackPanel>
              <Button x:Name="AssignShortcutButton"
                      Grid.Column="1"
                      Content="Assign shortcut"
                      IsEnabled="False"
                      Margin="8,0,6,0"
                      Click="AssignShortcut_Click"/>
              <Button x:Name="ClearShortcutButton"
                      Grid.Column="2"
                      Content="Clear"
                      IsEnabled="False"
                      Click="ClearShortcut_Click"/>
            </Grid>
          </Border>

          <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Play" MinWidth="82" Margin="0,0,6,6" Click="PlaySelected_Click">
              <StackPanel Orientation="Horizontal">
                <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource PlayIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                <TextBlock Text="Play" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </StackPanel>
            </Button>
            <Button AutomationProperties.Name="Pause" MinWidth="88" Margin="0,0,6,6" Click="Pause_Click">
              <StackPanel Orientation="Horizontal">
                <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource PauseIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                <TextBlock Text="Pause" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </StackPanel>
            </Button>
            <Button AutomationProperties.Name="Stop" MinWidth="80" Margin="0,0,6,6" Click="Stop_Click">
              <StackPanel Orientation="Horizontal">
                <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource StopIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                <TextBlock Text="Stop" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </StackPanel>
            </Button>
            <Button AutomationProperties.Name="Previous" MinWidth="104" Margin="0,0,6,6" Click="Previous_Click">
              <StackPanel Orientation="Horizontal">
                <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource PreviousIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                <TextBlock Text="Previous" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </StackPanel>
            </Button>
            <Button AutomationProperties.Name="Next" MinWidth="82" Margin="0,0,14,6" Click="Next_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Next" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource NextIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </StackPanel>
            </Button>
            <CheckBox x:Name="LoopSongBox" Content="Loop song" Margin="0,0,14,6" Click="LoopMode_Click"/>
            <CheckBox x:Name="LoopPlaylistBox" Content="Loop playlist" Margin="0,0,0,6" Click="LoopMode_Click"/>
          </WrapPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource CardStyle}">
        <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
          <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemedVerticalScrollBarStyle}"/>
          </ScrollViewer.Resources>
          <StackPanel>
            <TextBlock Text="Audio routing" Style="{StaticResource SectionTitleStyle}"/>

            <TextBlock Text="Microphone (your voice)" Margin="0,0,0,5"/>
            <ComboBox x:Name="MicBox" AutomationProperties.Name="Microphone" DisplayMemberPath="Name" SelectionChanged="MicBox_SelectionChanged"/>

            <TextBlock Text="Virtual microphone output" Margin="0,14,0,5"/>
            <ComboBox x:Name="OutputBox" AutomationProperties.Name="Virtual microphone output" DisplayMemberPath="Name" SelectionChanged="OutputBox_SelectionChanged"/>
            <TextBlock Text="Choose CABLE Input here. Apps listen on CABLE Output."
                       Style="{StaticResource SecondaryTextStyle}"
                       FontSize="12"
                       Margin="0,4,0,0"/>

            <TextBlock Text="Headset / speaker monitor" Margin="0,14,0,5"/>
            <ComboBox x:Name="MonitorBox" AutomationProperties.Name="Headset or speaker monitor" DisplayMemberPath="Name" SelectionChanged="MonitorBox_SelectionChanged"/>
            <CheckBox x:Name="MonitorBoxEnabled"
                      Content="Hear music and sounds in my headset"
                      IsChecked="True"
                      Margin="0,9,0,0"
                      Click="MonitorEnabled_Click"/>

            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,16"/>
            <TextBlock Text="Volume" Style="{StaticResource SectionTitleStyle}"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Voice to virtual mic"/>
              <TextBlock Grid.Column="1" Text="{Binding ElementName=MicVolume, Path=Value, StringFormat={}{0:P0}}" Style="{StaticResource SecondaryTextStyle}"/>
            </Grid>
            <Slider x:Name="MicVolume" AutomationProperties.Name="Voice volume to virtual mic" Minimum="0" Maximum="1.5" Value="1" ValueChanged="MicVolume_ValueChanged"/>

            <Grid Margin="0,13,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Music / sounds to virtual mic"/>
              <TextBlock Grid.Column="1" Text="{Binding ElementName=MusicToMicVolume, Path=Value, StringFormat={}{0:P0}}" Style="{StaticResource SecondaryTextStyle}"/>
            </Grid>
            <Slider x:Name="MusicToMicVolume" AutomationProperties.Name="Music and sounds volume to virtual mic" Minimum="0" Maximum="1.5" Value="1" ValueChanged="MusicToMicVolume_ValueChanged"/>

            <Grid Margin="0,13,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Music / sounds to headset"/>
              <TextBlock Grid.Column="1" Text="{Binding ElementName=MusicToHeadsetVolume, Path=Value, StringFormat={}{0:P0}}" Style="{StaticResource SecondaryTextStyle}"/>
            </Grid>
            <Slider x:Name="MusicToHeadsetVolume" AutomationProperties.Name="Music and sounds volume to headset" Minimum="0" Maximum="1.5" Value="1" ValueChanged="MusicToHeadsetVolume_ValueChanged"/>

            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,16"/>
            <TextBlock Text="Engine" Style="{StaticResource SectionTitleStyle}"/>
            <CheckBox x:Name="AutoStart" Content="Start automatically" IsChecked="True"/>
            <Button Content="Start / restart audio" Style="{StaticResource PrimaryButtonStyle}" Margin="0,12,0,0" Click="Restart_Click"/>
            <Button Content="Stop all audio" Margin="0,8,0,0" Click="StopAll_Click"/>

            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,16"/>
            <TextBlock Text="Playback shortcuts" Style="{StaticResource SectionTitleStyle}"/>
            <TextBlock x:Name="PlaybackShortcutHelpText"
                       Text="Assign optional global shortcuts for the playback controls."
                       Style="{StaticResource SecondaryTextStyle}"
                       FontSize="12"
                       Margin="0,-6,0,10"/>
            <ItemsControl x:Name="PlaybackShortcutsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="76"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            Background="{DynamicResource ElevatedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="7,5"
                            Margin="0,0,6,0">
                      <TextBlock Text="{Binding Key}" Style="{StaticResource SecondaryTextStyle}" FontSize="12"/>
                    </Border>
                    <Button Grid.Column="2"
                            Content="Assign"
                            AutomationProperties.Name="{Binding Name, StringFormat=Assign {0} shortcut}"
                            Style="{StaticResource SmallButtonStyle}"
                            Margin="0,0,5,0"
                            Click="AssignPlaybackShortcut_Click"/>
                    <Button Grid.Column="3"
                            Content="Clear"
                            AutomationProperties.Name="{Binding Name, StringFormat=Clear {0} shortcut}"
                            Style="{StaticResource SmallButtonStyle}"
                            IsEnabled="{Binding HasHotkey}"
                            Click="ClearPlaybackShortcut_Click"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="Status" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText"
                           Text="Not started"
                           AutomationProperties.LiveSetting="Polite"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <TextBlock Grid.Row="3"
               Margin="4,12,0,0"
               Style="{StaticResource SecondaryTextStyle}"
               FontSize="12"
               Text="WAV, MP3, M4A, AAC, WMA, FLAC, and OGG supported. Settings are saved automatically."/>
  </Grid>
</Window>
